{
  "name": "zauberjournal",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "npm run dev --workspace @zauberjournal/server",
    "dev:app": "npm run start --workspace @zauberjournal/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "tinybase": {
      "react": "19.2.3",
      "react-dom": "19.2.3"
    }
  }
}
